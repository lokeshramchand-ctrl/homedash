# Loki 3.x single binary, filesystem storage. Rendered by homedash-config from addons.loki_server.
# Install as /etc/loki/config.yml in your Loki container and restart loki.
auth_enabled: false

server:
  http_listen_port: {{loki_listen_port}}
  grpc_listen_port: 9096
  log_level: warn
  http_server_read_timeout: 120s
  http_server_write_timeout: 120s

common:
  instance_addr: 127.0.0.1
  path_prefix: /var/lib/loki
  storage:
    filesystem:
      chunks_directory: /var/lib/loki/chunks
      rules_directory: /var/lib/loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: 2020-10-24
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

ingester:
  chunk_idle_period: 30m
  max_chunk_age: 2h
  chunk_encoding: snappy

# Retention is enforced by the compactor, not by the filesystem.
compactor:
  working_directory: /var/lib/loki/compactor
  compaction_interval: 10m
  retention_enabled: true
  retention_delete_delay: 2h
  retention_delete_worker_count: 150
  delete_request_store: filesystem
  delete_request_cancel_period: 15m

limits_config:
  retention_period: {{loki_retention_hours}}h     # {{addons.loki_server.retention_days}} days; homedash's Logs page reads at most 31
  retention_stream:
    - selector: '{job="nginx-access"}'   # high volume, low long-term value
      priority: 1
      period: {{loki_nginx_retention_hours}}h
    - selector: '{level="debug"}'
      priority: 2
      period: 72h
  ingestion_rate_mb: 8
  ingestion_burst_size_mb: 16
  per_stream_rate_limit: 5MB
  per_stream_rate_limit_burst: 15MB
  max_streams_per_user: 20000
  max_label_names_per_series: 20
  max_line_size: 256KB
  max_line_size_truncate: true
  reject_old_samples: true
  reject_old_samples_max_age: 168h
  max_query_lookback: {{loki_retention_hours}}h
  max_query_series: 5000
  max_entries_limit_per_query: 5000
  query_timeout: 60s
  split_queries_by_interval: 6h
  volume_enabled: true
  allow_structured_metadata: true
  discover_log_levels: true
  metric_aggregation_enabled: true

pattern_ingester:
  enabled: true

query_range:
  align_queries_with_step: true
  cache_results: true
  results_cache:
    cache:
      embedded_cache:
        enabled: true
        max_size_mb: 100

analytics:
  reporting_enabled: false
