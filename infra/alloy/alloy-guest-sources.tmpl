#!/bin/bash
# Generates /etc/alloy/guests.alloy: one loki.source.journal per running LXC guest, reading the guest's
# persistent journal through /proc/<init pid>/root (no agent inside the guest, no bind mounts that could
# pin a rootfs and block pct stop/backup). Re-run every minute by alloy-guest-sources.timer; reloads
# Alloy only when the set of guests / init PIDs changed (e.g. after a guest restart).
# Guests need a persistent journal: mkdir -p /var/log/journal && systemctl restart systemd-journald
set -euo pipefail
OUT=/etc/alloy/guests.alloy
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

echo "// GENERATED by /usr/local/sbin/alloy-guest-sources - do not edit" > "$TMP"
for id in $(pct list | awk 'NR>1 && $2=="running"{print $1}'); do
  pid=$(lxc-info -n "$id" -p -H 2>/dev/null || true)
  [[ "$pid" =~ ^[0-9]+$ ]] || continue
  dir="/proc/$pid/root/var/log/journal"
  [ -d "$dir" ] || continue                      # no systemd / not persistent (Alpine guests)
  name=$(pct config "$id" | awk '/^hostname:/{print $2}')
  name=${name//[^A-Za-z0-9_.-]/_}
  cat >> "$TMP" <<BLOCK

loki.source.journal "ct${id}" {
  path          = "${dir}"
  max_age       = "12h"
  labels        = { job = "systemd-journal", host = "${name}", ctid = "${id}", kind = "guest" }
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.write.lab.receiver]
}
BLOCK
done

if ! cmp -s "$TMP" "$OUT" 2>/dev/null; then
  install -m 0644 -o root -g root "$TMP" "$OUT"
  systemctl is-active --quiet alloy && systemctl reload alloy || true
  logger -t alloy-guest-sources "guest source list changed, alloy reloaded ($(grep -c '^loki.source.journal' "$OUT") guests)"
fi
