# managed by homedash-config: edit /etc/homedash/homedash.yaml (nginx.homedash), not this file.
# homedash behind nginx. Set server.https: true so the app issues secure cookies and trusts this proxy.
limit_req_zone  $binary_remote_addr zone=hd_login:10m rate=6r/m;
limit_req_zone  $binary_remote_addr zone=hd_api:10m   rate=20r/s;
limit_conn_zone $binary_remote_addr zone=hd_conn:10m;

{{#if nginx.homedash.tls_cert}}
{{#if nginx.homedash.redirect_http}}
server {
    listen 80;
    server_name {{nginx.homedash.domain}};
    return 301 https://$host$request_uri;
}

{{/if}}
{{/if}}
server {
{{#if nginx.homedash.tls_cert}}
    listen 443 ssl;
    http2 on;
{{else}}
    listen 80;
{{/if}}
    server_name {{nginx.homedash.domain}};

{{#if nginx.homedash.tls_cert}}
    ssl_certificate     {{nginx.homedash.tls_cert}};
    ssl_certificate_key {{nginx.homedash.tls_key}};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:hd_ssl:5m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

{{/if}}
{{#if nginx.homedash.allow}}
    # only these networks may reach the dashboard
{{#each nginx.homedash.allow}}
    allow {{.}};
{{/each}}
    deny all;

{{/if}}
    client_max_body_size  64k;
    client_body_timeout   10s;
    client_header_timeout 10s;
    send_timeout          30s;
    keepalive_timeout     30s;
    limit_conn            hd_conn 40;
    limit_req             zone=hd_api burst=60 nodelay;
    limit_req_status      429;
    limit_conn_status     429;
    location ~ /\.        { return 404; }
    add_header X-Robots-Tag "noindex, nofollow" always;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $remote_addr;   # overwrite, never trust client-supplied values
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header Connection        "";
    proxy_hide_header X-Powered-By;
    proxy_connect_timeout 5s;

    # sign-in: strict brute-force limit on top of the app's own lockout
    location = /api/auth/login {
        limit_req zone=hd_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:{{port}};
    }
    location = /api/auth/mfa/verify {
        limit_req zone=hd_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:{{port}};
    }

    location / {
        proxy_pass http://127.0.0.1:{{port}};
        proxy_read_timeout 60s;
    }
}
