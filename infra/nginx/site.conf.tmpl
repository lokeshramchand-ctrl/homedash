# managed by homedash-config: edit /etc/homedash/homedash.yaml (nginx.sites), not this file.
# {{site.domain}} -> {{site.upstream}}
{{#if site.websocket}}
map $http_upgrade $hd_up_{{site.id}} { default upgrade; '' close; }

{{/if}}
{{#if site.tls_cert}}
{{#if site.redirect_http}}
server {
    listen 80;
    server_name {{site.domain}};
    return 301 https://$host$request_uri;
}

{{/if}}
{{/if}}
server {
{{#if site.tls_cert}}
    listen 443 ssl;
    http2 on;
{{else}}
    listen 80;
{{/if}}
    server_name {{site.domain}};

{{#if site.tls_cert}}
    ssl_certificate     {{site.tls_cert}};
    ssl_certificate_key {{site.tls_key}};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

{{/if}}
{{#if site.internal_only}}
    # internal only: private networks and anything listed in nginx.internal_networks
    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
{{#each nginx.internal_networks}}
    allow {{.}};
{{/each}}
    deny all;

{{/if}}
{{#if site.allow}}
{{#each site.allow}}
    allow {{.}};
{{/each}}
    deny all;

{{/if}}
    client_max_body_size {{#if site.max_body}}{{site.max_body}}{{else}}1m{{/if}};

    location / {
        proxy_pass {{site.upstream}};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout {{#if site.read_timeout}}{{site.read_timeout}}{{else}}60s{{/if}};
{{#if site.websocket}}
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $hd_up_{{site.id}};
{{else}}
        proxy_set_header Connection "";
{{/if}}
{{#if site.upstream_tls_insecure}}
        proxy_ssl_verify off;
{{/if}}
    }
}
