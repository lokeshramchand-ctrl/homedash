# Normally you do not edit this file: /etc/homedash/homedash.yaml is rendered into .env by `homedash-config apply`.
# Every variable below can also be set by hand (outside the managed block).
# Copy to .env (never commit it). Loaded with `node --env-file=.env`.

PORT=3000
HOST=127.0.0.1
TRUST_PROXY=true              # behind nginx
COOKIE_SECURE=true            # set false only for plain-http local testing
SESSION_TTL_HOURS=12
SERVE_DIST=                   # optional: path to the built UI (dist/) if the backend should serve it

# SQLite database: users, sessions, login rate-limit, audit log, Kuma history
DB_PATH=./data/homedash.db

# Proxmox (API token, roles: VM.PowerMgmt, VM.Audit, Sys.Audit)
PVE_URL=https://192.168.1.10:8006
PVE_NODE=pve
PVE_TOKEN_ID=dashboard@pve!ui
PVE_TOKEN_SECRET=
PVE_INSECURE_TLS=true         # self-signed cert
ALLOWED_VMIDS=                # comma list; empty = all guests on the node
PROTECTED_VMIDS=120           # refused server-side for every action
FEATURED_VMID=                # optional: show this guest as a large card on the Guests page
GUEST_CONFLICTS={"100":[101,106],"101":[100],"106":[100]}
# Kill switch: lets the dashboard power off the whole Proxmox node (needs Sys.PowerMgmt on /nodes/<node>).
# Powering back on is not possible from here (the dashboard dies with the host).
HOST_POWER_ENABLED=false

# nginx (read-only bind mount)
NGINX_SITES_DIR=/etc/nginx/sites-enabled
NGINX_MANAGE=false            # true lets the Nginx page create, edit and delete sites (nginx must run on this machine; every change is tested with nginx -t and rolled back on failure)
NGINX_BIN=nginx

# Grafana (see grafana/README.md). Token: read-only service account; Grafana needs allow_embedding = true
GRAFANA_URL=http://192.168.1.14:3000
GRAFANA_PUBLIC_URL=https://grafana.home.lan
GRAFANA_TOKEN=
GRAFANA_DS_UID=               # Prometheus datasource uid
METRICS_TOKEN=                # enables GET /metrics for Prometheus/Grafana; empty = disabled

# Uptime Kuma (/metrics with API key)
KUMA_URL=http://192.168.1.15:3001
KUMA_API_KEY=
KUMA_POLL_MS=60000

# Extra origins the UI may embed in iframes (space separated), e.g. the Kuma status page host
FRAME_SRC=

# Protection / capacity thresholds
BACKUP_MAX_AGE_DAYS=8         # newest backup older than this = stale
SNAPSHOT_MAX_AGE_DAYS=30      # snapshots older than this are flagged
MEMORY_RESERVE_MB=1024        # RAM kept free for the host when checking whether a guest fits

# Host journal for the Logs page (the service user must be in the systemd-journal group)
JOURNAL_ENABLED=true
EVENT_RETENTION_DAYS=90

# Single sign-on with any OpenID Connect provider (Keycloak, Authentik, Authelia, Zitadel, Entra ID, Google, Okta, ...).
# Create a client (authorization code + PKCE) with the redirect URI below. SSO stays OFF unless OIDC_ALLOWED_USERS
# and/or OIDC_REQUIRED_ROLE is set. The older KEYCLOAK_* names still work.
OIDC_ISSUER=                  # https://sso.example.com/realms/<realm>  (must serve /.well-known/openid-configuration)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=           # empty for a public client
OIDC_REDIRECT_URI=            # https://<dashboard host>/api/auth/sso/callback
OIDC_SCOPES=openid profile email
OIDC_ALLOWED_USERS=           # comma list of preferred_username or email
OIDC_REQUIRED_ROLE=           # a role or group the user must have
OIDC_ROLES_CLAIM=             # where roles live in the ID token; default covers Keycloak, `roles` and `groups`
OIDC_LABEL=Single sign-on     # text on the login button

# ntfy push alerts (optional). Topic should be unguessable if the server allows anonymous subscribe.
NTFY_URL=
NTFY_PUBLIC_URL=
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_CLICK_URL=
# alert thresholds (fractions), sustained 5 min
ALERT_CPU=0.9
ALERT_MEM=0.92
ALERT_DISK=0.9

# Ask AI: optional OpenAI-compatible endpoint for inline log debugging.
# A local Ollama keeps data on your LAN: AI_BASE_URL=http://192.168.1.x:11434/v1, AI_MODEL=llama3.1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_LABEL=

# Loki (read-only; the Logs page queries it live). Empty = off.
LOKI_URL=
LOKI_PUBLIC_URL=
# Prometheus for CrowdSec history and engine counters. Empty = off.
PROMETHEUS_URL=

# CrowdSec page: path of the snapshot JSON written by the host timer (infra/crowdsec). Empty = off.
CROWDSEC_SNAPSHOT=
CROWDSEC_CENTRAL_NAME=crowdsec
CROWDSEC_HOST_NAME=pve-host

# Two-step sign-in (TOTP). MFA_KEY (32+ chars) turns it on; MFA_REQUIRED forces enrolment.
MFA_KEY=
MFA_REQUIRED=false
MFA_ISSUER=homedash
SESSION_IDLE_MINUTES=120
# Roles for SSO sign-ins (viewer | operator | admin); users in OIDC_ADMIN_USERS get admin
OIDC_ADMIN_USERS=
OIDC_DEFAULT_ROLE=admin

# LLM server page (llama.cpp on a Windows VM) and GPU mining guard. See scripts/windows/.
LLAMA_URL=
LLAMA_API_KEY=
LLAMA_AGENT_URL=
LLAMA_AGENT_TOKEN=
LLAMA_PUBLIC_URL=
LLAMA_VMID=0
GPU_AGENT_URL=
GPU_AGENT_TOKEN=
GPU_WATCH_VMID=0

# Data manager (MongoDB, Redis, PostgreSQL, MySQL/MariaDB, SQL Server, SQLite, Milvus). DATASOURCE_KEY (16+ chars) turns it on;
# it seals saved passwords, so losing it means re-entering them. Generate: openssl rand -base64 32
DATASOURCE_KEY=
DATASOURCE_SQLITE_DIRS=
DATASOURCE_ALLOWED_NETS=
# Connections declared as DS_<ID>_KIND (+ NAME HOST PORT DATABASE USERNAME PASSWORD URI TLS TLS_INSECURE CA_FILE FILE TOKEN READONLY COLOR)
# appear on the Data page, read-only unless DS_<ID>_READONLY=false. Removing the block removes the connection.
# DS_MAIN_KIND=postgres
# DS_MAIN_HOST=192.168.1.42

# More alert channels next to ntfy. Each is off until its settings are set; alerts go to every channel that is on.
GOTIFY_URL=
GOTIFY_TOKEN=
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=homedash
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=                   # comma list
SMTP_INSECURE_TLS=false
APPRISE_URL=               # Apprise API server
APPRISE_KEY=               # saved configuration key, or ...
APPRISE_URLS=              # ... space separated service URLs
APPRISE_TAG=
WEBHOOK_URL=
WEBHOOK_SECRET=
