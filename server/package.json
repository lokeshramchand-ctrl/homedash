{
  "name": "homedash-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "start": "node --disable-warning=ExperimentalWarning --env-file=.env build/index.js",
    "create-user": "node --disable-warning=ExperimentalWarning --env-file=.env build/create-user.js",
    "test": "tsc && node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "config": "node --disable-warning=ExperimentalWarning build/homedash-config.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.2.0",
    "undici": "^7.2.0",
    "yaml": "^2.6.1",
    "nodemailer": "^6.9.16",
    "@simplewebauthn/server": "^13.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "@types/mssql": "12.3.0",
    "@types/pg": "^8.23.1",
    "@types/nodemailer": "^6.4.17"
  },
  "optionalDependencies": {
    "@zilliz/milvus2-sdk-node": "^3.0.6",
    "mongodb": "^6.12.0",
    "mssql": "12.7.9",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "redis": "^5.12.1"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  },
  "bin": {
    "homedash-config": "build/homedash-config.js"
  }
}
